# Base locale PostgreSQL. Les valeurs par défaut de compose.yaml conviennent au développement.
POSTGRES_DB=gestion_utilisateurs
POSTGRES_USER=gestion_app
POSTGRES_PASSWORD=local-dev-change-me

# L'authentification reste désactivée uniquement pour le poste local.
# Le fichier compose.production.yaml la force à true sur le VPS.
AUTH_ENABLED=false
APP_HOST_PORT=18473
API_HOST_PORT=18474
APP_ORIGIN=http://localhost:18473
TRUST_PROXY=false
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Premier compte créé uniquement si AUTH_ENABLED=true et qu'aucun compte n'existe encore.
# En production, laisser BOOTSTRAP_ADMIN_PASSWORD vide : le mot de passe vient du secret Docker.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrateur CEY
BOOTSTRAP_ADMIN_PASSWORD=

# Clé propre à cette instance pour chiffrer les identifiants saisis dans l'interface.
# Générer 32 octets aléatoires en base64. En production, préférer le fichier secret.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_FILE=

# Utiliser le sandbox pour les essais, puis https://api.helloasso.com en production.
HELLOASSO_BASE_URL=https://api.helloasso-sandbox.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANIZATION_SLUG=

# Envoi d'e-mails via OVH MX Plan (Europe) : port 587 + STARTTLS.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@escrime-cey.fr
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@escrime-cey.fr
SMTP_FROM_NAME=Cercle d'Escrime de Yerres
# Facultatif : adresse qui recevra les réponses.
SMTP_REPLY_TO=

# Extensions locales. EXTENSIONS_BUNDLED_DIRECTORY est livré en lecture seule avec l'image ;
# EXTENSIONS_DIRECTORY est le volume persistant des extensions installées localement.
# Le catalogue et la licence centrale resteront vides tant que le serveur central n'est pas
# mis en service.
EXTENSIONS_BUNDLED_DIRECTORY=/app/bundled-plugins
EXTENSIONS_DIRECTORY=/app/plugins
EXTENSION_CATALOG_URL=
EXTENSION_LICENSE_TOKEN=
EXTENSION_LICENSE_PUBLIC_KEY=
# Recommandé avec Docker : posez la clé publique du serveur central dans
# ./secrets/catalog-public.pem (monté en lecture seule par compose.yaml, dossier vide et sans
# effet par défaut) puis renseignez EXTENSION_LICENSE_PUBLIC_KEY_FILE=/app/secrets/catalog-public.pem
# ici. Laissé vide, l'application reste en mode local (aucun appel au serveur central).
EXTENSION_LICENSE_PUBLIC_KEY_FILE=
EXTENSION_OFFLINE_GRACE_DAYS=30
# À ne jamais activer en production. Réservé au développement futur de paquets locaux.
EXTENSION_ALLOW_UNSIGNED=false
