{
  "schemaVersion": 1,
  "id": "irl-documents",
  "name": "Documents IRL",
  "description": "Courriers papier personnalisés, modèles et exports PDF ou ZIP.",
  "version": "1.0.0",
  "core": { "minimum": "0.1.0" },
