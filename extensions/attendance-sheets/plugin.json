  "migrations": ["001_attendance_records_index.sql"],
  "routes": [
    "/api/school-holidays",
    "/api/groups/:groupId/schedules",
    "/api/groups/:groupId/attendance-sheet",
    "/api/groups/:groupId/attendance"
  ]
