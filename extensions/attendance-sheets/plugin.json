{
  "schemaVersion": 1,
  "id": "attendance-sheets",
  "name": "Feuilles de présence",
  "description": "Créneaux hebdomadaires, vacances scolaires, génération et saisie des feuilles de présence.",
  "version": "1.0.0",
  "core": { "minimum": "0.1.0" },
  "dependencies": [],
  "optionalDependencies": ["fencing-categories"],
  "capabilities": ["navigation", "group-panel"],
  "entitlementKey": "attendance-sheets",
