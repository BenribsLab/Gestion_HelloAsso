{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@gu/extension-host": ["../apps/api/src/extension-host.ts"]
    }
  },
  "include": ["web-host.d.ts", "*/src/**/*.ts", "*/src/**/*.tsx"]
}
